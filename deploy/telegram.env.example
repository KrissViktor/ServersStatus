STATUS_TELEGRAM_TOKEN=REPLACE_WITH_BOT_TOKEN
STATUS_TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
# Optional: route only Telegram through a local SOCKS5 proxy.
# STATUS_TELEGRAM_PROXY=socks5h://127.0.0.1:1080
# Calendar-day summary, sent once after 09:00 Moscow time.
STATUS_DAILY_REPORT_ENABLED=1
STATUS_DAILY_REPORT_HOUR=9
# Optional: restrict commands inside the configured chat to these Telegram user IDs.
# STATUS_TELEGRAM_ALLOWED_USERS=123456789,987654321
STATUS_PANEL_URL=https://panel.vikserver.ru
