[Unit]
Description=Hysteria2 local SOCKS5 client for ServersStatus Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=hysteria-client
Group=hysteria-client
ExecStart=/usr/local/bin/hysteria client -c /etc/hysteria-telegram/client.yaml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
