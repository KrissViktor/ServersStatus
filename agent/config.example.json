{
  "server_url": "https://status.example.com",
  "agent_id": "sql-server-01",
  "token": "REPLACE_WITH_INDIVIDUAL_AGENT_KEY",
  "interval_seconds": 10,
  "allow_application_checks": false,
  "services": [
    "MSSQLSERVER"
  ],
  "backups": [
    {
      "path": "D:\\Backups",
      "pattern": "**/*.bak",
      "max_age_hours": 26
    }
  ],
  "allow_remote_console": false
}
